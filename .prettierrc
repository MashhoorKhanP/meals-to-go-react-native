{
    "tabWidth": 4,
    "printWidth": 100,
    "endOfLine": "auto",
    "arrowParens": "avoid",
    "trailingComma": "es5",
    "semi": true,
    "useTabs": false,
    "singleQuote": false,
    "bracketSpacing": true,
    "plugins": [
        "prettier-plugin-tailwindcss",
        "prettier-plugin-packagejson",
        "prettier-plugin-organize-imports"
    ]
}
